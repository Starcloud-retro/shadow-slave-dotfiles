* {
    background: rgba(5, 5, 8, 0.88);
    background-alt: rgba(12, 7, 20, 0.95);
    primary: #9d4edd;
    primary-fixed: #c77dff;
    primary-fixed-dim: #9d4edd;
    on-primary: #ffffff;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #e0d6eb;
    primary-container: #3c096c;
    on-primary-container: #ffffff;
    secondary: #7b2cbf;
    secondary-fixed: #9d4edd;
    secondary-fixed-dim: #7b2cbf;
    on-secondary: #ffffff;
    on-secondary-fixed: #ffffff;
    on-secondary-fixed-variant: #e0d6eb;
    secondary-container: #240046;
    on-secondary-container: #ffffff;
    tertiary: #5a189a;
    tertiary-fixed: #7b2cbf;
    tertiary-fixed-dim: #5a189a;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #e0d6eb;
    tertiary-container: #3c096c;
    on-tertiary-container: #ffffff;
    error: #ff4d6d;
    on-error: #ffffff;
    error-container: #590d22;
    on-error-container: #ffffff;
    surface: #0a0612;
    on-surface: #ffffff;
    on-surface-variant: #e0d6eb;
    outline: #7b2cbf;
    outline-variant: #3c096c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ffffff;
    inverse-on-surface: #050508;
    inverse-primary: #9d4edd;
    surface-dim: #050508;
    surface-bright: #180b26;
    surface-container-lowest: #000000;
    surface-container-low: #050508;
    surface-container: #0a0612;
    surface-container-high: #12081f;
    surface-container-highest: #180b26;
}
